{
  "rules": {
    "players": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$i": {
        ".validate": "newData.hasChildren(['name', 'presence']) && newData.child('name').isString() && newData.child('name').val().length <= 30 && newData.child('presence').isNumber()"
      }
    },
    "seating": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    }
  }
}
