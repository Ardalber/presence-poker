{
  "rules": {
    "players": {
      ".read": true,
      "$id": {
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || ($id === auth.uid && root.child('banned').child(auth.uid).val() !== true))",
        ".validate": "newData.hasChildren(['name', 'presence']) && newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('name').val().length <= 30 && newData.child('presence').isNumber() && newData.child('presence').val() >= -1 && newData.child('presence').val() <= 1",
        "name": { ".validate": "newData.isString()" },
        "presence": { ".validate": "newData.isNumber()" },
        "order": { ".validate": "newData.isNumber()" },
        "uid": { ".validate": "newData.isString() && newData.val() === $id" },
        "$other": { ".validate": false }
      }
    },
    "seating": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "users": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name', 'lastSeen'])",
        "name": { ".validate": "newData.isString() && newData.val().length <= 60" },
        "photo": { ".validate": "newData.isString() && newData.val().length <= 1000" },
        "lastSeen": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },
    "banned": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
      }
    },
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    }
  }
}
